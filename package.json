{
  "name": "arvan-watch-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b --noEmit",
    "typecheck:watch": "vue-tsc -b --noEmit --watch",
    "build": "vue-tsc -b && vite build",
    "build:docker": "vue-tsc -b && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json,css,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.101.4",
    "core-js": "^3.50.0",
    "hls.js": "^1.5.7",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.4.21",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "@tanstack/vue-query-devtools": "^5.91.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.29.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.2.8",
    "vite-plugin-compression": "^0.5.1",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
