# Copy to `.env` before running the app. Without it the base URL is empty and
# every API call falls back to the dev server origin (localhost:5173), where
# Vite's SPA fallback answers with index.html instead of JSON.
VITE_API_BASE_URL=https://streaming-dashboard.objectstorage-h0um1.arvanedge.ir

# Optional — dev/preview server port (defaults to 5173).
# VITE_PORT=5173
